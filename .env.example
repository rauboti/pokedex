# Copy to `.env` for local development (`.env` is gitignored). docker-compose.yml carries
# defaults for everything here, so an empty .env still boots the stack.
#
# What these mean, and how the pieces fit together: see the root README
# ("Prerequisites" for the hive setup, "Running the stack" for the port band and dev loops).

# ---- Database ----
POSTGRES_DB=pokedex
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex_local_dev
POSTGRES_PORT=5437

# ---- API ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3050

# ---- Hive (identity) ----
# EXTERNAL is how the browser reaches hive (and the expected token `iss`); INTERNAL is how the
# api container reaches it. Equal standalone; in the shared stack INTERNAL is hive's service
# name (http://hive-api:8080). Endpoint paths are derived in code.
HIVE_EXTERNAL_URL=http://localhost:5000
HIVE_INTERNAL_URL=http://localhost:5000
HIVE_CLIENT_ID=pokedex
# Issued by hive when pokedex is registered. Blank falls back to the dev-profile default.
HIVE_CLIENT_SECRET=

# Public web origin. Also defines the OAuth redirect URI as {WEB_BASE_URL}/auth/callback —
# register THAT in hive.
WEB_BASE_URL=http://localhost:3050

# ---- Game data ----
# Community Game Master source for the species/move catalog. Point at a stub or dead host to
# exercise the sync failure paths.
GAMEDATA_BASE_URL=https://pokemon-go-api.github.io/pokemon-go-api

# ---- Frontend (dev only) ----
# The api origin `yarn dev` proxies to; in the container nginx proxies /api instead.
VITE_API_ORIGIN=http://localhost:5050

# ---- Build ----
# GitHub Packages token (read:packages) for the private @rauboti/ui scope. Needed only to build
# the web image. Same token as web/.yarnrc.yml.
RAUBOTI_PACKAGE_TOKEN=
